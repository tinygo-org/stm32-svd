              <enumeratedValues>
                <name>PGSERRW</name>
                <usage>write</usage>
                <enumeratedValue>
                  <name>Clear</name>
                  <description>Cleared by writing 1</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
