            </field>
            <field>
              <name>CSBF</name>
              <description>Clear standby flag
Setting this bit clears the SBF flag in the PWR_SR1 register.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <name>CSBF</name>
                <enumeratedValue>
                  <name>Clear</name>
                  <description>Setting this bit clears the SBF flag in the PWR_SR1 register</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
