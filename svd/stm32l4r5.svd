                <enumeratedValue>
                  <name>Set</name>
                  <description>This bit is set only. When set, all bits concerning user option in FLASH_CR register and so option page are locked</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>LOCK</name>
