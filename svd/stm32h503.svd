            <field>
              <name>DBG_GPDMA1_1_STOP</name>
              <description>GPDMA1 channel 1 stop in debug</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
