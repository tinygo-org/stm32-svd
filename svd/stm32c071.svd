              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>write-only</access>
            </field>
            <field>
              <name>CWUF6</name>
              <description>Clear wakeup flag 6
Setting this bit clears the WUF6 flag in the PWR_SR1 register.</description>
              <bitOffset>5</bitOffset>
