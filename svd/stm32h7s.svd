          <resetMask>0xFFFFFFFF</resetMask>
          <fields>
            <field>
              <name>FRAME</name>
              <description>frame number
Current value of the relative frame counter 2.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>12</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
