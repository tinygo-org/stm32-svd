The unitary value of delay for this field depends on product technology (refer to the product datasheet).</description>
              <bitOffset>16</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CALSOR</name>
