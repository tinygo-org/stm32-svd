              <description>I2C Not I3C
Write to change corresponding bit in FLASH_OBW2SR register.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
          </fields>
        </register>
