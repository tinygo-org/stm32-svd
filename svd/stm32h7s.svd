            <field>
              <name>PC_EXTI10</name>
              <description>Port configuration EXTI {2 * 4 + i}
This bitfield selects the source input to the EXTI input {2 * 4 + i} used for external interrupt/ event detection.
Others: reserved</description>
              <bitOffset>8</bitOffset>
