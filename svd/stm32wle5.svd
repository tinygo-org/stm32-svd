                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CombinedResetTrigger</name>
                  <description>SMS[0:2] must be 0b000 (DisabledOrCombined). Combined reset + trigger mode - Rising edge of the selected trigger input (TRGI) reinitializes the counter, generates an update of the registers and starts the counter</description>
                  <value>1</value>
