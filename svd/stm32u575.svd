                  <value>4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Cycles68</name>
                  <description>68 ADC clock cycles</description>
                  <value>5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Cycles391</name>
                  <description>391 ADC clock cycles</description>
                  <value>6</value>
                </enumeratedValue>
