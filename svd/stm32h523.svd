    <peripheral>
      <name>DCMI</name>
      <description>DCMI address block description</description>
      <groupName>DCMI</groupName>
      <baseAddress>0x4202C000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x2C</size>
