                </enumeratedValue>
                <enumeratedValue>
                  <name>EXT2</name>
                  <description>External memory 2 selected (data exchanged over IO[7:4])</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FTHRES</name>
