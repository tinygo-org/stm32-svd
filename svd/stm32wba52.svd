            <field>
              <name>ERCFG3</name>
              <description>Configurable device secrets configuration</description>
              <bitOffset>3</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERCFG4</name>
              <description>Configurable device secrets configuration</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
            </field>
            <field>
              <name>ERCFG5</name>
